#:kivy 2.0.0

<CharacteristicFrameKivy>:
    orientation: 'vertical'
    padding: '10dp'
    spacing: '5dp'
    size_hint_y: None
    height: self.minimum_height
    md_bg_color: app.theme_cls.bg_light

    MDBoxLayout:
        size_hint_y: None
        height: '30dp'
        MDLabel:
            text: root.short_uuid
            font_style: 'H6'
            halign: 'left'
            text_size: self.width, None
        MDIconButton:
            icon: 'information-outline'
            on_release: root.show_info_popup()
        MDFlatButton:
            text: root.char_properties
            font_style: 'Caption'
            halign: 'right'
            text_size: self.width, None
            on_release: root.show_properties_popup()

    MDLabel:
        id: user_description_label
        text: ""
        font_style: 'Body1'
        halign: 'left'
        text_size: self.width, None
        size_hint_y: None
        height: 0 if not self.text else '20dp'

    MDBoxLayout:
        size_hint_y: None
        height: '30dp'
        MDTextField:
            id: value_input
            text: root.char_value
            size_hint_x: 0.6
        MDIconButton:
            icon: 'content-copy'
            on_release: root.copy_to_clipboard(root.char_value)
        Spinner:
            id: format_spinner
            text: 'Hex'
            values: ['Hex', 'ASCII', 'JSON', 'Int8', 'UInt8', 'Int16', 'UInt16', 'Int32', 'UInt32', 'Float32', 'Float64']
            size_hint_x: 0.3
            on_text: root.on_format_change(self.text)

    MDBoxLayout:
        size_hint_y: None
        height: '30dp'
        spacing: '5dp'
        MDRaisedButton:
            id: read_button
            text: 'Read'
        MDRaisedButton:
            id: write_button
            text: 'Write'
        MDSwitch:
            id: subscribe_button
        MDLabel:
            text: 'Subscribe'
        MDBoxLayout:
            id: write_controls
            size_hint_y: None
            height: '30dp' if root.characteristic and ("write" in root.characteristic.properties or "write-without-response" in root.characteristic.properties) else 0
            opacity: 1 if root.characteristic and ("write" in root.characteristic.properties or "write-without-response" in root.characteristic.properties) else 0
            disabled: not (root.characteristic and ("write" in root.characteristic.properties or "write-without-response" in root.characteristic.properties))

            Spinner:
                id: write_mode_spinner
                text: 'ASCII'
                values: ['ASCII', 'Hex']
