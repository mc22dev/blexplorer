#:kivy 2.0.0

<CharacteristicFrameKivy>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: '4dp'

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        canvas.before:
            Color:
                rgba: app.theme.secondary
            Rectangle:
                pos: self.pos
                size: self.size

        Button:
            on_release: root.toggle_collapse()
            background_color: app.theme.header_bg
            BoxLayout:
                size: self.parent.size
                pos: self.parent.pos
                Label:
                    text: root.char_name
                Label:
                    text: root.char_uuid
                    font_size: '12sp'
                Label:
                    text: root.full_char_properties
                    font_size: '10sp'

        BoxLayout:
            id: content
            orientation: 'vertical'
            padding: '10dp'
            spacing: '10dp'
            size_hint_y: None
            height: 0 if root.collapsed else self.minimum_height
            opacity: 0 if root.collapsed else 1

            Label:
                id: user_description_label
                text: ""
                halign: 'left'
                text_size: self.width, None
                size_hint_y: None
                height: 0 if not self.text else '20dp'

            BoxLayout:
                size_hint_y: None
                height: '48dp'
                TextInput:
                    id: value_input
                    text: root.char_value
                    size_hint_x: 0.6
                Button:
                    font_name: "MaterialIcons"
                    text: '\U000F018F'
                    on_release: root.copy_to_clipboard(root.char_value)
                Spinner:
                    id: format_spinner
                    text: 'Hex'
                    values: ['Hex', 'ASCII', 'JSON', 'Int8', 'UInt8', 'Int16', 'UInt16', 'Int32', 'UInt32', 'Float32', 'Float64']
                    size_hint_x: 0.3
                    on_text: root.on_format_change(self.text)

            BoxLayout:
                size_hint_y: None
                height: '48dp'
                spacing: '10dp'
                Button:
                    id: read_button
                    text: 'Read'
                Button:
                    id: write_button
                    text: 'Write'
                Switch:
                    id: subscribe_button
                Label:
                    text: 'Subscribe'

            BoxLayout:
                id: write_controls
                size_hint_y: None
                height: '48dp' if root.characteristic and ("write" in root.characteristic.properties or "write-without-response" in root.characteristic.properties) else 0
                opacity: 1 if root.characteristic and ("write" in root.characteristic.properties or "write-without-response" in root.characteristic.properties) else 0

                Spinner:
                    id: write_mode_spinner
                    text: 'ASCII'
                    values: ['ASCII', 'Hex']
