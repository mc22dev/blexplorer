#:kivy 2.0.0
#:import theme_manager theme.theme_manager

<MainLayout>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: theme_manager.background
        Rectangle:
            pos: self.pos
            size: self.size

    # Top Adapter Bar
    BoxLayout:
        size_hint_y: None
        height: '48dp'
        padding: '5dp'
        spacing: '5dp'

        Label:
            text: 'Adapter:'
            size_hint_x: None
            width: '80dp'
            color: theme_manager.text
        Spinner:
            id: adapter_spinner
            text: 'Default'
            values: ['Default']
            size_hint_x: 0.3
            background_color: theme_manager.button_bg
            color: theme_manager.button_fg
        Button:
            text: 'Refresh'
            size_hint_x: 0.1
            background_color: theme_manager.button_bg
            color: theme_manager.button_fg
        Button:
            id: scan_button
            text: 'Scan'
            size_hint_x: 0.1
            disabled: app.is_scan_button_disabled
            background_color: theme_manager.button_bg
            color: theme_manager.button_fg
        Button:
            id: parameter_button
            text: 'Parameters'
            size_hint_x: 0.15
            on_release: app.open_parameter_window()
            background_color: theme_manager.button_bg
            color: theme_manager.button_fg
        Button:
            id: disconnect_button
            text: 'Disconnect'
            size_hint_x: 0.2
            disabled: True
            background_color: theme_manager.button_bg
            color: theme_manager.button_fg

    # Main Content Area
    BoxLayout:
        orientation: 'horizontal'

        # Left Pane: Device List
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.4

            TextInput:
                id: search_input
                hint_text: 'Filter devices'
                size_hint_y: None
                height: '30dp'
                on_text: app.filter_devices(self.text)
                background_color: theme_manager.input_bg
                foreground_color: theme_manager.input_fg

            ScrollView:
                id: device_scroll_view
                do_scroll_x: False
                BoxLayout:
                    id: device_list
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height

        # Right Pane: Characteristics and Log
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.6

            # Toolbar
            BoxLayout:
                size_hint_y: None
                height: '48dp'
                padding: '5dp'
                spacing: '5dp'

                Button:
                    id: read_all_button
                    text: 'Read All'
                    disabled: True
                    background_color: theme_manager.button_bg
                    color: theme_manager.button_fg
                Button:
                    id: clear_log_button
                    text: 'Clear Log'
                    background_color: theme_manager.button_bg
                    color: theme_manager.button_fg
                Button:
                    id: save_log_button
                    text: 'Save Log'
                    background_color: theme_manager.button_bg
                    color: theme_manager.button_fg
                Button:
                    id: ota_button
                    text: 'OTA'
                    on_release: app.open_ota_window()
                    background_color: theme_manager.button_bg
                    color: theme_manager.button_fg

            ScrollView:
                id: char_scroll_view
                do_scroll_x: False
                BoxLayout:
                    id: characteristic_list
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    Label:
                        text: 'Characteristics will appear here'
                        color: theme_manager.text

            TextInput:
                id: log_view
                text: ''
                readonly: True
                size_hint_y: 0.4
                background_color: theme_manager.input_bg
                foreground_color: theme_manager.input_fg
