#:kivy 2.0.0
<MainLayout>:
    orientation: 'vertical'
    BoxLayout:
        id: main_toolbar
        size_hint_y: None
        height: "48dp"
        canvas.before:
            Color:
                rgba: app.theme.header_bg
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "BLE Scanner"
            size_hint_x: 3
        Button:
            font_name: "MaterialIcons"
            text: "\U000F0493"
            on_release: app.open_parameter_window()
        Button:
            id: scan_button
            font_name: "MaterialIcons"
            text: "\U000F0349"
            on_release: app.scan_for_devices()
        Button:
            id: disconnect_button
            font_name: "MaterialIcons"
            text: "\U000F0338"
            on_release: app.disconnect_from_device()
            disabled: not app.is_connected
    TabbedPanel:
        id: bottom_nav
        do_default_tab: False
        TabbedPanelItem:
            text: 'Scanner'
            BoxLayout:
                orientation: 'vertical'
                TextInput:
                    id: search_input
                    hint_text: 'Filter devices'
                    size_hint_y: None
                    height: '48dp'
                    on_text: app.filter_devices(self.text)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.children[0].height
                    Label:
                        text: "Connecting..."
                        halign: "center"
                        color: app.theme.secondary
                        opacity: 1 if app.is_connecting else 0
                        size_hint_y: None
                        height: self.texture_size[1] if self.opacity else 0
                GlobalRSSIGraph:
                    id: global_rssi_graph
                    size_hint_y: 0.4
                    device_data: app.global_graph_data if app else {}
                ScrollView:
                    id: device_scroll_view
                    size_hint_y: 0.6
                    GridLayout:
                        id: device_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
        TabbedPanelItem:
            id: device_screen_tab
            text: 'Device'
            disabled: not app.is_connected
            BoxLayout:
                orientation: 'vertical'
                BoxLayout:
                    id: device_toolbar
                    size_hint_y: None
                    height: "48dp"
                    canvas.before:
                        Color:
                            rgba: app.theme.header_bg
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: "Device Info"
                    Button:
                        id: refresh_button
                        font_name: "MaterialIcons"
                        text: "\U000F0450"
                        on_release: app.read_all_characteristics()
                    Button:
                        id: upload_button
                        font_name: "MaterialIcons"
                        text: "\U000F0552"
                        on_release: app.open_ota_window()
                ScrollView:
                    id: char_scroll_view
                    GridLayout:
                        id: characteristic_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        Label:
                            text: 'Characteristics will appear here'
        TabbedPanelItem:
            text: 'Log'
            BoxLayout:
                orientation: 'vertical'
                BoxLayout:
                    id: log_toolbar
                    size_hint_y: None
                    height: "48dp"
                    canvas.before:
                        Color:
                            rgba: app.theme.header_bg
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: "Log"
                    Button:
                        font_name: "MaterialIcons"
                        text: "\U000F01B4"
                        on_release: app.clear_log()
                    Button:
                        font_name: "MaterialIcons"
                        text: "\U000F0193"
                        on_release: app.show_save_dialog()
                ScrollView:
                    TextInput:
                        id: log_view
                        text: ''
                        multiline: True
                        readonly: True
                        size_hint_y: None
                        height: self.minimum_height