#:kivy 2.0.0

<MainLayout>:
    orientation: 'vertical'
    md_bg_color: app.theme_cls.bg_dark

    # Top Adapter Bar
    MDBoxLayout:
        size_hint_y: None
        height: '48dp'
        padding: '5dp'
        spacing: '5dp'

        MDLabel:
            text: 'Adapter:'
            size_hint_x: None
            width: '80dp'
        Spinner:
            id: adapter_spinner
            text: 'Default'
            values: ['Default']
            size_hint_x: 0.3
        MDRaisedButton:
            text: 'Refresh'
            size_hint_x: 0.1
        MDRaisedButton:
            id: scan_button
            text: 'Scan'
            size_hint_x: 0.1
            disabled: app.is_scan_button_disabled
        MDRaisedButton:
            id: parameter_button
            text: 'Parameters'
            size_hint_x: 0.15
            on_release: app.open_parameter_window()
        MDRaisedButton:
            id: disconnect_button
            text: 'Disconnect'
            size_hint_x: 0.2
            disabled: True

    # Main Content Area
    MDBoxLayout:
        orientation: 'horizontal'

        # Left Pane: Device List
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.4

            MDTextField:
                id: search_input
                hint_text: 'Filter devices'
                size_hint_y: None
                height: '30dp'
                on_text: app.filter_devices(self.text)

            ScrollView:
                id: device_scroll_view
                do_scroll_x: False
                MDBoxLayout:
                    id: device_list
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height

        # Right Pane: Characteristics and Log
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.6

            # Toolbar
            MDBoxLayout:
                size_hint_y: None
                height: '48dp'
                padding: '5dp'
                spacing: '5dp'

                MDRaisedButton:
                    id: read_all_button
                    text: 'Read All'
                    disabled: True
                MDRaisedButton:
                    id: clear_log_button
                    text: 'Clear Log'
                MDRaisedButton:
                    id: save_log_button
                    text: 'Save Log'
                MDRaisedButton:
                    id: ota_button
                    text: 'OTA'
                    on_release: app.open_ota_window()

            ScrollView:
                id: char_scroll_view
                do_scroll_x: False
                MDBoxLayout:
                    id: characteristic_list
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    MDLabel:
                        text: 'Characteristics will appear here'

            MDTextField:
                id: log_view
                text: ''
                readonly: True
                size_hint_y: 0.4
