#:kivy 2.0.0

<MainLayout>:
    orientation: 'vertical'

    BoxLayout:
        id: main_toolbar
        size_hint_y: None
        height: "48dp"
        canvas.before:
            Color:
                rgba: app.theme.header_bg
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "BLE Scanner"
            size_hint_x: 3
        Button:
            text: "Settings"
            on_release: app.open_parameter_window()
        Button:
            id: scan_button
            text: "Scan"
            on_release: app.scan_for_devices()
        Button:
            id: disconnect_button
            text: "Disconnect"
            on_release: app.disconnect_from_device()
            disabled: not app.is_connected

    TabbedPanel:
        id: bottom_nav
        do_default_tab: False

        TabbedPanelItem:
            text: 'Scanner'
            BoxLayout:
                orientation: 'vertical'

                TextInput:
                    id: search_input
                    hint_text: 'Filter devices'
                    size_hint_y: None
                    height: '48dp'
                    on_text: app.filter_devices(self.text)

                BoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    Label:
                        text: "Connecting..."
                        halign: "center"
                        color: app.theme.secondary
                        opacity: 1 if app.is_connecting else 0
                        size_hint_y: None
                        height: self.texture_size[1] if self.opacity else 0

                ScrollView:
                    id: device_scroll_view
                    GridLayout:
                        id: device_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height

        TabbedPanelItem:
            id: device_screen_tab
            text: 'Device'
            disabled: not app.is_connected

            BoxLayout:
                orientation: 'vertical'

                BoxLayout:
                    id: device_toolbar
                    size_hint_y: None
                    height: "48dp"
                    canvas.before:
                        Color:
                            rgba: app.theme.header_bg
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: "Device Info"
                    Button:
                        id: refresh_button
                        text: "Read All"
                        on_release: app.read_all_characteristics()
                    Button:
                        id: upload_button
                        text: "OTA Update"
                        on_release: app.open_ota_window()

                ScrollView:
                    id: char_scroll_view
                    GridLayout:
                        id: characteristic_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        Label:
                            text: 'Characteristics will appear here'

        TabbedPanelItem:
            text: 'Log'

            BoxLayout:
                orientation: 'vertical'
                BoxLayout:
                    id: log_toolbar
                    size_hint_y: None
                    height: "48dp"
                    canvas.before:
                        Color:
                            rgba: app.theme.header_bg
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: "Log"
                    Button:
                        text: "Clear"
                        on_release: app.clear_log()
                    Button:
                        text: "Save"
                        on_release: app.show_save_dialog()
                ScrollView:
                    TextInput:
                        id: log_view
                        text: ''
                        multiline: True
                        readonly: True
                        size_hint_y: None
                        height: self.minimum_height
