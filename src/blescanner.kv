#:kivy 2.0.0

#:include scanner_screen.kv
#:include device_screen.kv
#:include log_screen.kv

<MainLayout>:
    orientation: 'vertical'

    BoxLayout:
        id: main_toolbar
        size_hint_y: None
        height: "48dp"
        canvas.before:
            Color:
                rgba: app.theme.header_bg if app else (0,0,0,1)
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "BLE Scanner"
            size_hint_x: 3

        TooltipButton:
            font_name: "MaterialIcons"
            text: "\U000F0493"
            on_release: app.open_parameter_window()
            tooltip_text: "Settings"

        TooltipButton:
            id: scan_button
            font_name: "MaterialIcons"
            text: "\U000F0349"
            on_release: app.scan_for_devices()
            disabled: app.is_scanning if app else True
            tooltip_text: "Scan for devices"

        TooltipButton:
            id: disconnect_button
            font_name: "MaterialIcons"
            text: "\U000F0338"
            on_release: app.disconnect_from_device()
            disabled: not app.is_connected if app else True
            tooltip_text: "Disconnect"

    TabbedPanel:
        id: bottom_nav
        do_default_tab: False

        TabbedPanelItem:
            text: 'Scanner'
            ScannerScreen:
                id: scanner_screen

        TabbedPanelItem:
            id: device_screen_tab
            text: 'Device'
            disabled: not app.is_connected if app else True
            DeviceScreen:
                id: device_screen

        TabbedPanelItem:
            text: 'Log'
            LogScreen:
                id: log_screen

        TabbedPanelItem:
            text: 'Wireshark'
            WiresharkScreen:
                id: wireshark_screen
