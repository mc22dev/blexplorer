#:kivy 2.0.0

<MainLayout>:
    orientation: 'vertical'

    MDTopAppBar:
        title: "BLE Scanner"
        left_action_items: [["cog-outline", lambda x: app.open_parameter_window()]]
        right_action_items: [["bluetooth-scan", lambda x: app.scan_for_devices(), {"disabled": app.is_scanning}], ["logout", lambda x: app.disconnect_from_device(), {"disabled": not app.is_connected}]]

    MDScreen:
        MDBottomNavigation:
            id: bottom_nav
            panel_color: app.theme_cls.bg_light

            MDBottomNavigationItem:
                name: 'scanner_screen'
                text: 'Scanner'
                icon: 'bluetooth'

                MDBoxLayout:
                    orientation: 'vertical'

                    Spinner:
                        id: adapter_spinner
                        text: 'Default'
                        values: ['Default']
                        size_hint_y: None
                        height: "48dp"
                        on_text: app.on_adapter_selected(self, self.text)

                    MDTextField:
                        id: search_input
                        hint_text: 'Filter devices'
                        size_hint_y: None
                        height: '48dp'
                        on_text: app.filter_devices(self.text)

                    ScrollView:
                        id: device_scroll_view
                        MDBoxLayout:
                            id: device_list
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height

            MDBottomNavigationItem:
                name: 'device_screen'
                text: 'Device'
                icon: 'cellphone-link'
                disabled: not app.is_connected

                MDBoxLayout:
                    orientation: 'vertical'

                    MDTopAppBar:
                        title: "Device Info"
                        right_action_items: [["refresh", lambda x: app.read_all_characteristics(), {"disabled": not app.is_connected}], ["upload", lambda x: app.open_ota_window(), {"disabled": not app.is_connected}]]

                    ScrollView:
                        id: char_scroll_view
                        MDBoxLayout:
                            id: characteristic_list
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            MDLabel:
                                text: 'Characteristics will appear here'

            MDBottomNavigationItem:
                name: 'log_screen'
                text: 'Log'
                icon: 'text-box-outline'

                MDBoxLayout:
                    orientation: 'vertical'
                    MDTopAppBar:
                        title: "Log"
                        right_action_items: [["delete", lambda x: app.clear_log()], ["content-save", lambda x: app.show_save_dialog()]]
                    MDTextField:
                        id: log_view
                        text: ''
                        multiline: True
                        readonly: True
