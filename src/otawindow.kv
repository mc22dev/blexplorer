#:kivy 2.0.0

<OTAWindow>:
    title: "Xiaomi OTA"
    size_hint: 0.8, 0.6
    auto_dismiss: False

    MDBoxLayout:
        orientation: 'vertical'
        padding: '10dp'
        spacing: '10dp'

        MDLabel:
            id: file_label
            text: 'No file selected'
            size_hint_y: None
            height: '30dp'

        MDProgressBar:
            id: progress_bar
            max: 100
            value: 0
            size_hint_y: None
            height: '24dp'

        MDBoxLayout:
            size_hint_y: None
            height: '48dp'
            spacing: '10dp'

            MDRaisedButton:
                id: upload_button
                text: 'Upload'
            MDRaisedButton:
                text: 'Close'
                on_release: root.dismiss()
