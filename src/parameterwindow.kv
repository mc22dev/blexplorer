#:kivy 2.0.0

<ParameterWindow>:
    title: 'Parameters'
    size_hint: 0.6, 0.4
    auto_dismiss: False

    MDBoxLayout:
        orientation: 'vertical'
        padding: '10dp'
        spacing: '10dp'

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '30dp'

            MDLabel:
                text: 'Bluetooth Adapter:'
            Spinner:
                id: adapter_spinner
                text: 'Default'
                values: ['Default']

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '30dp'

            MDLabel:
                text: 'Scan Timeout:'
            MDTextField:
                id: scan_timeout_input
                text: '5.0'
                multiline: False

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '30dp'

            MDLabel:
                text: 'Theme:'
            Spinner:
                id: theme_spinner
                text: 'Dark'
                values: ['Light', 'Dark']

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '40dp'
            spacing: '10dp'

            MDRaisedButton:
                text: 'Restore Defaults'
                on_release: app.restore_default_parameters(root)
            MDRaisedButton:
                text: 'OK'
                on_release: app.update_parameters(root)
            MDRaisedButton:
                text: 'Cancel'
                on_release: root.dismiss()
