#:kivy 2.0.0
#:import theme_manager theme.theme_manager

<DescriptorFrameKivy>:
    orientation: 'vertical'
    padding: '10dp'
    spacing: '5dp'
    size_hint_y: None
    height: self.minimum_height

    canvas.before:
        Color:
            rgba: theme_manager.secondary
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: f"Descriptor UUID: {root.desc_uuid}"
        font_size: '14sp'
        halign: 'left'
        text_size: self.width, None
        color: theme_manager.text

    BoxLayout:
        size_hint_y: None
        height: '30dp'
        Label:
            text: 'Value:'
            size_hint_x: 0.2
            color: theme_manager.text
        TextInput:
            id: value_input
            text: root.desc_value
            size_hint_x: 0.8
            background_color: theme_manager.input_bg
            foreground_color: theme_manager.input_fg

    BoxLayout:
        size_hint_y: None
        height: '30dp'
        spacing: '5dp'
        Button:
            id: read_button
            text: 'Read'
            background_color: theme_manager.button_bg
            color: theme_manager.button_fg
        Button:
            id: write_button
            text: 'Write'
            background_color: theme_manager.button_bg
            color: theme_manager.button_fg
