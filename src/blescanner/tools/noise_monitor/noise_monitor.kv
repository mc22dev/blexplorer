#:kivy 2.0.0

<NoiseMonitorScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: "20dp"
        spacing: "20dp"

        FloatLayout:
            # Large Bar Graph (Uses all available space)
            NoiseBarGraph:
                id: bar_graph
                size_hint: (1, 1)
                pos_hint: {'x': 0, 'y': 0}
                level: root.noise_level
                num_bars: root.num_bars

            # Missing Dependency Overlay (similar to audio_analyzer)
            BoxLayout:
                orientation: 'vertical'
                padding: "20dp"
                spacing: "10dp"
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                size_hint: (0.8, 0.6)
                opacity: 1 if not root.has_pyaudio else 0
                disabled: root.has_pyaudio
                canvas.before:
                    Color:
                        rgba: (0, 0, 0, 0.8)
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "PyAudio dependency missing"
                    bold: True
                    font_size: '18sp'
                Label:
                    text: "To use the Noise Monitor, you must install PyAudio and its system dependencies."
                    text_size: self.width, None
                    halign: 'center'
                Label:
                    text: "On Ubuntu/Debian:\nsudo apt-get install libportaudio2 portaudio19-dev\npip install pyaudio"
                    text_size: self.width, None
                    halign: 'center'
                    color: (0.7, 0.7, 1, 1)
