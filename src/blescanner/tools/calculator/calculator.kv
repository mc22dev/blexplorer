#:kivy 2.0.0

<CalcButton@Button>:
    font_size: '18sp'
    background_normal: ''
    background_color: app.theme.primary if app else (0.2, 0.2, 0.2, 1)
    color: (1, 1, 1, 1)

<BaseLabel@Label>:
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    font_name: 'UbuntuMono'
    font_size: '14sp'
    size_hint_y: None
    height: '25dp'

<CalculatorScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: '10dp'
        spacing: '10dp'

        # Display Area
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '160dp'
            padding: '10dp'
            spacing: '2dp'
            canvas.before:
                Color:
                    rgba: (0.1, 0.1, 0.1, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            BaseLabel:
                text: "HEX: " + root.hex_display
            BaseLabel:
                text: "DEC: " + root.dec_display
            BaseLabel:
                text: "BIN: " + root.bin_display

            Widget:
                size_hint_y: None
                height: '10dp'

            TextInput:
                text: root.expression
                readonly: True
                font_name: 'UbuntuMono'
                font_size: '24sp'
                background_color: (0, 0, 0, 0)
                foreground_color: (1, 1, 1, 1)
                multiline: False
                cursor_color: (1, 1, 1, 1)
                halign: 'right'

        # Mode Selection
        BoxLayout:
            size_hint_y: None
            height: '45dp'
            spacing: '10dp'

            Spinner:
                text: str(root.bit_length) + "-bit"
                values: ('8-bit', '16-bit', '32-bit', '64-bit')
                on_text: root.set_bit_length(int(self.text.split('-')[0]))
                background_color: app.theme.secondary if app else (0.3, 0.3, 0.3, 1)

            ToggleButton:
                text: "Signed" if root.is_signed else "Unsigned"
                state: 'down' if root.is_signed else 'normal'
                on_release: root.toggle_signed()
                background_color: app.theme.secondary if app else (0.3, 0.3, 0.3, 1)

        # Keypad
        GridLayout:
            cols: 6
            spacing: '5dp'

            CalcButton:
                text: 'A'
                on_release: root.add_to_expression('A')
            CalcButton:
                text: 'B'
                on_release: root.add_to_expression('B')
            CalcButton:
                text: 'C'
                on_release: root.add_to_expression('C')
            CalcButton:
                text: 'D'
                on_release: root.add_to_expression('D')
            CalcButton:
                text: 'E'
                on_release: root.add_to_expression('E')
            CalcButton:
                text: 'F'
                on_release: root.add_to_expression('F')

            CalcButton:
                text: '7'
                on_release: root.add_to_expression('7')
            CalcButton:
                text: '8'
                on_release: root.add_to_expression('8')
            CalcButton:
                text: '9'
                on_release: root.add_to_expression('9')
            CalcButton:
                text: '('
                on_release: root.add_to_expression('(')
            CalcButton:
                text: ')'
                on_release: root.add_to_expression(')')
            CalcButton:
                text: 'CE'
                background_color: app.theme.error if app else (0.8, 0, 0, 1)
                on_release: root.clear_expression()

            CalcButton:
                text: '4'
                on_release: root.add_to_expression('4')
            CalcButton:
                text: '5'
                on_release: root.add_to_expression('5')
            CalcButton:
                text: '6'
                on_release: root.add_to_expression('6')
            CalcButton:
                text: '*'
                on_release: root.add_to_expression('*')
            CalcButton:
                text: '/'
                on_release: root.add_to_expression('/')
            CalcButton:
                text: 'BS'
                background_color: app.theme.warning if app else (0.8, 0.5, 0, 1)
                on_release: root.backspace()

            CalcButton:
                text: '1'
                on_release: root.add_to_expression('1')
            CalcButton:
                text: '2'
                on_release: root.add_to_expression('2')
            CalcButton:
                text: '3'
                on_release: root.add_to_expression('3')
            CalcButton:
                text: '+'
                on_release: root.add_to_expression('+')
            CalcButton:
                text: '-'
                on_release: root.add_to_expression('-')
            CalcButton:
                text: '%'
                on_release: root.add_to_expression('%')

            CalcButton:
                text: '0'
                on_release: root.add_to_expression('0')
            CalcButton:
                text: '0x'
                on_release: root.add_to_expression('0x')
            CalcButton:
                text: '0b'
                on_release: root.add_to_expression('0b')
            CalcButton:
                text: '<<'
                on_release: root.add_to_expression('<<')
            CalcButton:
                text: '>>'
                on_release: root.add_to_expression('>>')
            CalcButton:
                text: '&'
                on_release: root.add_to_expression('&')

            CalcButton:
                text: '|'
                on_release: root.add_to_expression('|')
            CalcButton:
                text: '^'
                on_release: root.add_to_expression('^')
            CalcButton:
                text: '~'
                on_release: root.add_to_expression('~')
            CalcButton:
                text: 'ROR'
                on_release: root.add_to_expression('ROR(')
            CalcButton:
                text: 'ROL'
                on_release: root.add_to_expression('ROL(')
            CalcButton:
                text: ','
                on_release: root.add_to_expression(',')
