#:kivy 2.0.0

<AudioAnalyzerScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: "10dp"
        spacing: "10dp"

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "10dp"
            disabled: not root.has_pyaudio
            Button:
                id: start_stop_button
                text: "Start" if not root.is_running else "Stop"
                on_release: root.toggle_running()
            Label:
                text: "Peak: " + root.peak_freq_text
            Label:
                text: "FPS: " + root.fps_text
            Label:
                text: root.status_text
                color: (1, 0.5, 0.5, 1) if "Error" in root.status_text or "not found" in root.status_text else (1, 1, 1, 1)

        FloatLayout:
            SpectrumGraph:
                id: spectrum_graph
                magnitude_data: root.magnitude_data
                frequencies: root.frequencies
                is_log_x: True
                is_log_y: True
                pos_hint: {'x': 0, 'y': 0}

            BoxLayout:
                orientation: 'vertical'
                padding: "20dp"
                spacing: "10dp"
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                size_hint: (0.8, 0.6)
                opacity: 1 if not root.has_pyaudio else 0
                canvas.before:
                    Color:
                        rgba: (0, 0, 0, 0.8)
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "PyAudio dependency missing"
                    bold: True
                    font_size: '18sp'
                Label:
                    text: "To use the Audio Spectrum Analyzer, you must install PyAudio and its system dependencies."
                    text_size: self.width, None
                    halign: 'center'
                Label:
                    text: "On Ubuntu/Debian:\nsudo apt-get install libportaudio2 portaudio19-dev\npip install pyaudio"
                    text_size: self.width, None
                    halign: 'center'
                    color: (0.7, 0.7, 1, 1)

<SpectrumGraph>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
