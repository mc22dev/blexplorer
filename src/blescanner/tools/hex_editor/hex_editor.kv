#:kivy 2.0.0

<HexEditorRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '25dp'
    padding: ['5dp', 0]
    canvas.before:
        Color:
            rgba: (0.15, 0.15, 0.15, 1) if root.index % 2 == 0 else (0.1, 0.1, 0.1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        id: offset_label
        text: root.offset_text
        size_hint_x: None
        width: '100dp'
        font_name: 'UbuntuMono'
        font_size: '14sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        color: app.theme.secondary if app else (0.5, 0.5, 0.5, 1)

    Label:
        id: hex_label
        text: root.hex_text
        font_name: 'UbuntuMono'
        font_size: '14sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        size_hint_x: None
        width: '350dp'
        color: (1, 1, 1, 1)
        canvas.after:
            Color:
                rgba: (1, 1, 1, 0.3) if root.selected_byte != -1 and root.edit_in_hex else (0, 0, 0, 0)
            Rectangle:
                pos: (self.x + root.selected_byte * (self.width / 16), self.y) if root.selected_byte != -1 else (0,0)
                size: (self.width / 16, self.height) if root.selected_byte != -1 else (0,0)

    Label:
        id: ascii_label
        text: root.ascii_text
        font_name: 'UbuntuMono'
        font_size: '14sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        size_hint_x: None
        width: '150dp'
        color: (0.8, 0.8, 0.8, 1)
        canvas.after:
            Color:
                rgba: (1, 1, 1, 0.3) if root.selected_byte != -1 and not root.edit_in_hex else (0, 0, 0, 0)
            Rectangle:
                pos: (self.x + root.selected_byte * (self.width / 16), self.y) if root.selected_byte != -1 else (0,0)
                size: (self.width / 16, self.height) if root.selected_byte != -1 else (0,0)

<HexEditorScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: '5dp'
        spacing: '5dp'

        # Toolbar
        BoxLayout:
            size_hint_y: None
            height: '48dp'
            spacing: '5dp'
            Button:
                text: 'Load'
                on_release: root.load_file_dialog()
            Button:
                text: 'Save'
                on_release: root.save_file_dialog()
            Button:
                text: 'Insert'
                on_release: root.insert_byte()
            Button:
                text: 'Delete'
                on_release: root.delete_byte()

            Widget: # Spacer

        # Search / Replace
        BoxLayout:
            size_hint_y: None
            height: '40dp'
            spacing: '5dp'
            TextInput:
                id: search_input
                hint_text: 'Search pattern'
                multiline: False
            TextInput:
                id: replace_input
                hint_text: 'Replace with'
                multiline: False
            ToggleButton:
                id: hex_mode_toggle
                text: 'Hex'
                state: 'down'
                size_hint_x: None
                width: '60dp'
            Button:
                text: 'Search'
                size_hint_x: None
                width: '80dp'
                on_release: root.search(search_input.text, hex_mode_toggle.state == 'down')
            Button:
                text: 'Replace'
                size_hint_x: None
                width: '80dp'
                on_release: root.replace(search_input.text, replace_input.text, hex_mode_toggle.state == 'down')

        # Main View
        RecycleView:
            id: rv
            viewclass: 'HexEditorRow'
            data: root.view_data
            RecycleBoxLayout:
                default_size: None, dp(25)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'

        # Status Bar
        Label:
            size_hint_y: None
            height: '30dp'
            text: root.status_text
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            font_size: '12sp'
            color: (0.7, 0.7, 0.7, 1)
