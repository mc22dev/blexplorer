#:kivy 2.0.0

<LogScreen@BoxLayout>:
    orientation: 'vertical'
    BoxLayout:
        id: log_toolbar
        size_hint_y: None
        height: "48dp"
        canvas.before:
            Color:
                rgba: app.theme.header_bg if app else (0,0,0,1)
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "Log"
        TooltipButton:
            font_name: "MaterialIcons"
            text: "\U000F01B4"
            on_release: app.clear_log() if app else None
            tooltip_text: "Clear log"
        TooltipButton:
            font_name: "MaterialIcons"
            text: "\U000F0193"
            on_release: app.show_save_dialog() if app else None
            tooltip_text: "Save log"
        CheckBox:
            id: autoscroll_checkbox
            active: True
            size_hint_x: None
            width: "48dp"
        Label:
            text: "Auto-scroll"
            size_hint_x: 2
    ScrollView:
        id: log_scroll_view
        TextInput:
            id: log_view
            text: ''
            multiline: True
            readonly: True
            size_hint_y: None
            height: self.minimum_height
