#:kivy 2.0.0

<WiresharkScreen>:
    orientation: 'vertical'
    BoxLayout:
        id: wireshark_toolbar
        size_hint_y: None
        height: "48dp"
        canvas.before:
            Color:
                rgba: app.theme.header_bg
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "Wireshark"
        TooltipButton:
            font_name: "MaterialIcons"
            text: "\U000F01B4"
            on_release: app.clear_wireshark_log()
            tooltip_text: "Clear log"
        TooltipButton:
            font_name: "MaterialIcons"
            text: "\U000F0193"
            on_release: app.show_save_wireshark_dialog()
            tooltip_text: "Save log"
        CheckBox:
            id: autoscroll_checkbox
            active: True
            size_hint_x: None
            width: "48dp"
        Label:
            text: "Auto-scroll"
            size_hint_x: 2

    BoxLayout:
        size_hint_y: None
        height: "24dp"
        canvas.before:
            Color:
                rgba: app.theme.header_bg if app else (0.2, 0.2, 0.2, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "Time"
            size_hint_x: 0.12
            bold: True
        Label:
            text: "Delay"
            size_hint_x: 0.08
            bold: True
        Label:
            text: "RSSI"
            size_hint_x: 0.07
            bold: True
        Label:
            text: "Address"
            size_hint_x: 0.16
            bold: True
        Label:
            text: "Service UUIDs"
            size_hint_x: 0.15
            bold: True
        Label:
            text: "Service Data"
            size_hint_x: 0.15
            bold: True
        Label:
            text: "Manufacturer Data"
            size_hint_x: 0.15
            bold: True
        Label:
            text: "Decoded Data"
            size_hint_x: 0.15
            bold: True

    RecycleView:
        id: wireshark_log_view
        data: app.wireshark_data if app else []
        viewclass: 'WiresharkLogEntry'
        scroll_type: ['bars', 'content']
        bar_width: '10dp'

        RecycleBoxLayout:
            default_size: None, dp(48)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'
