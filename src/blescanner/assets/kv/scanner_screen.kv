#:kivy 2.0.0

<ScannerScreen@BoxLayout>:
    orientation: 'vertical'
    BoxLayout:
        size_hint_y: None
        height: '48dp'
        TextInput:
            id: search_input
            hint_text: 'Filter devices'
            on_text: app.filter_devices(self.text) if app else None
        Button:
            id: clear_filter_button
            text: 'Clear'
            size_hint_x: None
            width: '80dp'
            on_release: app.clear_device_filter() if app else None
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: self.children[0].height
        Label:
            text: "Connecting..."
            halign: "center"
            color: app.theme.secondary if app else (0, 0, 0, 0)
            opacity: 1 if app and app.is_connecting else 0
            size_hint_y: None
            height: self.texture_size[1] if self.opacity else 0
    CollapsibleFrameKivy:
        id: rssi_graph_frame
        title: "RSSI Graph"
        size_hint_y: None
        height: self.minimum_height
        is_expanded: True
        GlobalRSSIGraph:
            id: global_rssi_graph
            size_hint_y: None
            height: '200dp'
            device_data: app.global_graph_data if app else {}
            rssi_min: app.rssi_min if app else -110
            rssi_max: app.rssi_max if app else -20

    ScrollView:
        id: device_scroll_view
        GridLayout:
            id: device_list
            cols: 1
            size_hint_y: None
            height: self.minimum_height
