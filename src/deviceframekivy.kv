#:kivy 2.0.0

<DeviceFrameKivy>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '120dp'
    padding: "8dp"
    on_release: app.connect_to_device(root)
    background_color: app.theme.primary if root.is_selected else app.theme.secondary

    Button:
        id: graph_toggle
        size_hint_x: None
        width: '20dp'
        on_release: root.toggle_graph_selection()
        canvas:
            Color:
                rgba: root.indicator_color
            Ellipse:
                size: (12, 12)
                pos: self.center_x - 6, self.center_y - 6
            Color:
                rgba: (1, 1, 1, 1) if root.is_graph_selected else (0, 0, 0, 0)
            Line:
                circle: (self.center_x, self.center_y, 8)
                width: 1

    Button:
        text: "Connect"
        size_hint_x: 0.2
        on_release: app.connect_to_device(root)

    BoxLayout:
        orientation: 'vertical'
        padding: "8dp"
        size_hint_x: 0.6

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height
            TextInput:
                id: device_name_input
                text: root.custom_device_name
                hint_text: "Custom Name"
                bold: True
                size_hint_y: None
                height: self.minimum_height
                multiline: False
                on_text_validate: root.save_custom_name(self.text)
            Button:
                text: "Save"
                size_hint_x: None
                width: "50dp"
                on_release: root.save_custom_name(device_name_input.text)

        Label:
            text: f"Original Name: {root.device_name}"
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1]

        Label:
            text: root.device_address
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1]

        Button:
            text: root.service_uuids
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1]
            on_release: root.show_full_data_popup("Service UUIDs", root.full_service_uuids)
            background_color: (0,0,0,0)
            color: app.theme.primary

        Button:
            text: root.manufacturer_data
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1]
            on_release: root.show_full_data_popup("Manufacturer Data", root.full_manufacturer_data)
            background_color: (0,0,0,0)
            color: app.theme.primary

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.4

        Label:
            text: root.rssi_info
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1]

        Label:
            text: root.period_info
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1]

        Label:
            text: root.adv_flags
            font_size: '12sp'
            size_hint_y: None
            height: self.texture_size[1]

    Button:
        text: "Copy"
        size_hint_x: 0.2
        on_release: root.copy_to_clipboard(root.device_address)
