#:kivy 2.0.0

<DeviceFrameKivy>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: '2dp'
    padding: '5dp'
    md_bg_color: app.theme_cls.primary_color if self.hovered else app.theme_cls.bg_light

    MDLabel:
        id: device_name
        text: root.device_name
        size_hint_y: None
        height: '24dp'
        font_style: 'H6'
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None

    MDLabel:
        id: device_address
        text: root.device_address
        size_hint_y: None
        height: '20dp'
        font_style: 'Caption'
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None

    MDBoxLayout:
        size_hint_y: None
        height: '20dp'
        MDLabel:
            text: 'RSSI: '
            size_hint_x: None
            width: self.texture_size[0]
        MDLabel:
            id: rssi_label
            text: root.device_rssi
            size_hint_x: None
            width: '40dp'
        MDRaisedButton:
            text: 'Copy'
            size_hint_x: 0.2
            on_release: root.copy_to_clipboard(root.device_address)
