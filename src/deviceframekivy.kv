#:kivy 2.0.0

<DeviceFrameKivy>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height

    MDCard:
        size_hint_y: None
        height: "80dp"
        padding: "8dp"
        on_release: app.connect_to_device(root.device)

        MDBoxLayout:
            adaptive_height: True

            IconLeftWidget:
                icon: "bluetooth"

            MDBoxLayout:
                orientation: 'vertical'
                adaptive_height: True
                padding: "8dp"

                MDLabel:
                    text: root.device_name
                    bold: True
                    adaptive_height: True

                MDLabel:
                    text: root.device_address
                    font_style: "Caption"
                    adaptive_height: True

                MDLabel:
                    text: root.service_uuids
                    font_style: "Caption"
                    adaptive_height: True

                MDLabel:
                    text: root.manufacturer_data
                    font_style: "Caption"
                    adaptive_height: True

            MDBoxLayout:
                orientation: 'vertical'
                adaptive_height: True
                size_hint_x: 0.4

                MDLabel:
                    text: root.rssi_info
                    font_style: "Caption"
                    adaptive_height: True

                MDLabel:
                    text: root.period_info
                    font_style: "Caption"
                    adaptive_height: True

                MDLabel:
                    text: root.adv_flags
                    font_style: "Caption"
                    adaptive_height: True

            IconRightWidget:
                icon: "content-copy"
                on_release: root.copy_to_clipboard(root.device_address)
