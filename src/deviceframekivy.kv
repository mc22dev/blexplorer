#:kivy 2.0.0

<DeviceFrameKivy>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height

    MDCard:
        size_hint_y: None
        height: "88dp"
        padding: "8dp"
        on_release: app.connect_to_device(root.device)

        ThreeLineAvatarIconListItem:
            text: root.device_name
            secondary_text: root.device_address
            tertiary_text: f"RSSI: {root.device_rssi}"

            IconLeftWidget:
                icon: "bluetooth"

            IconRightWidget:
                icon: "content-copy"
                on_release: root.copy_to_clipboard(root.device_address)
